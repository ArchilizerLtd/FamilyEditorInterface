<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless flex engine. References RevitAPI only (no RevitAPIUI, no WPF) so it can run
       inside the interactive add-in and on Design Automation for Revit. See docs/flex-engine. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>FamilyEditorInterface.Flex</RootNamespace>
    <AssemblyName>FamilyEditorInterface.Flex</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- MSB3277: RevitAPI is built against Microsoft.VisualBasic 10.1 from the Windows Desktop runtime.
         Revit supplies it at runtime; referencing the desktop framework here would pull UI stacks into a headless library. -->
    <NoWarn>$(NoWarn);CA1416;MSB3277</NoWarn>

    <!-- Keep in sync with FamilyEditorInterface.csproj -->
    <RevitVersion>2027</RevitVersion>
    <RevitInstallDir>$(ProgramW6432)\Autodesk\Revit $(RevitVersion)</RevitInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
